# Ignore node_modules folder
node_modules/

# Ignore logs
*.log

# Ignore environment files that might contain secrets
.env
.env.local
.env.*.local

# Ignore OS system files (macOS, Windows)
.DS_Store
Thumbs.db

# Ignore VSCode settings folder
.vscode/

# Ignore compiled or build output folders (add if you have)
dist/
build/
out/

# Ignore coverage reports (if using testing)
coverage/

# Ignore temp files
*.tmp
*.temp

# Ignore npm debug files
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Optional: ignore wrangler local files if you want (check if it has secrets)
# wrangler.toml

# Ignore snapshots or other compiled artifacts if you add them later
